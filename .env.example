# Example environment for rkc. Copy to .env (gitignored) and fill in locally.
#
# Secrets live only in environment variables or .env, never in YAML, the
# claim store, logs or command output. Agent and cluster YAML refer to a key
# by its variable name through `api_key_env` (for example
# `api_key_env: OPENAI_API_KEY`), never by its value.
#
# This file is committed: it must never hold real values. Leave every
# placeholder empty.

# OpenAlex API key (optional: without it, OpenAlex is skipped with a notice).
OPENALEX_API_KEY=

# Example model key, referenced from agent YAML via `api_key_env`.
OPENAI_API_KEY=
